# ─── Dependencies ────────────────────────────────────────────────────────────
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ─── Build Outputs ───────────────────────────────────────────────────────────
dist/
build/
out/
.next/

# ─── TypeScript ──────────────────────────────────────────────────────────────
*.tsbuildinfo
next-env.d.ts

# ─── Environment & Secrets ───────────────────────────────────────────────────
.env
.env.*
!.env.example

# ─── Database Volumes (never commit raw Postgres data) ───────────────────────
postgres-data/
database/

# ─── Logs ────────────────────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ─── Test & Coverage ─────────────────────────────────────────────────────────
coverage/
.nyc_output/

# ─── Runtime / Process ───────────────────────────────────────────────────────
pids/
*.pid
*.seed
*.pid.lock
.temp/
.tmp/

# ─── Diagnostic Reports ──────────────────────────────────────────────────────
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# ─── OS ──────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini

# ─── IDEs & Editors ──────────────────────────────────────────────────────────
.idea/
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# VSCode — keep shared config, ignore personal workspace state
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# ─── SSL / Certificates ──────────────────────────────────────────────────────
*.pem
*.key
*.crt

# ─── Vercel ──────────────────────────────────────────────────────────────────
.vercel
